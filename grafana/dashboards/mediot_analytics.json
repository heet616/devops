{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Request Rate – All Services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total[1m])) by (service)",
        "legendFormat": "{{service}}",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Ingestion Latency",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(vital_ingestion_latency_seconds_bucket[5m])",
        "format": "heatmap",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "title": "Live Patient Vital Values",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "patient_vital_value",
        "legendFormat": "{{patient_id}} - {{sensor_type}}",
        "refId": "A",
        "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 110 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Alert Volume Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total{path=\"/api/v1/alerts\"}[5m]))",
        "legendFormat": "Alerts",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 100 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "title": "MedIoT Analytics",
  "uid": "mediot_main_dashboard"
}