FROM jenkins/jenkins:lts-jdk17

USER root

# Install Python, pip, and Docker CLI
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv \
    ca-certificates curl gnupg lsb-release

# Add Docker's official GPG key and repo
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

# Install Docker CLI and Compose Plugin
RUN apt-get update && apt-get install -y docker-ce-cli docker-compose-plugin

# Make python point to python3
RUN ln -s /usr/bin/python3 /usr/bin/python || true

# Change ownership of docker socket on host requires running jenkins in a group that can access it, 
# or we run Jenkins as root (simplest for a local demo). We will keep USER root for simplicity to allow docker socket access.
